/-- `exp z` to 16 Taylor terms for `0 ≤ z ≤ 1` (`Real.exp_bound`; `17/(16!·16) = 17/334764638208000`). -/
theorem exp_encl16 {z lo hi : ℝ} (hz0 : 0 ≤ z) (hz1 : z ≤ 1)
    (hlo : lo ≤ ∑ m ∈ Finset.range 16, z ^ m / m.factorial - z ^ 16 * (17 / 334764638208000))
    (hhi : ∑ m ∈ Finset.range 16, z ^ m / m.factorial + z ^ 16 * (17 / 334764638208000) ≤ hi) :
    lo ≤ exp z ∧ exp z ≤ hi := by
  have h := abs_le.mp (Real.exp_bound (x := z) (by rwa [abs_of_nonneg hz0]) (n := 16) (by norm_num))
  have e : |z| ^ 16 * (((Nat.succ 16 : ℕ) : ℝ) / (((Nat.factorial 16 : ℕ) : ℝ) * ((16 : ℕ) : ℝ))) =
      z ^ 16 * (17 / 334764638208000) := by
    rw [abs_of_nonneg hz0]; norm_num [Nat.factorial]
  exact ⟨by linarith [h.1], by linarith [h.2]⟩

/-- `cos a` to 8 Taylor terms for `0 ≤ a ≤ 2` (SmallB's `cos_taylor_encl` without the absolute values). -/
theorem cos_encl16 {a lo hi : ℝ} (ha0 : 0 ≤ a) (ha2 : a ≤ 2)
    (hlo : lo ≤ (1 - a ^ 2 / 2 + a ^ 4 / 24 - a ^ 6 / 720 + a ^ 8 / 40320 - a ^ 10 / 3628800 + a ^ 12 / 479001600
      - a ^ 14 / 87178291200) - a ^ 16 / 20922789888000 * 2)
    (hhi : (1 - a ^ 2 / 2 + a ^ 4 / 24 - a ^ 6 / 720 + a ^ 8 / 40320 - a ^ 10 / 3628800 + a ^ 12 / 479001600
      - a ^ 14 / 87178291200) + a ^ 16 / 20922789888000 * 2 ≤ hi) : lo ≤ cos a ∧ cos a ≤ hi := by
  have h := abs_of_nonneg ha0
  exact cos_taylor_encl (by rw [h]; exact ha2) (by rw [h]; exact hlo) (by rw [h]; exact hhi)

/-- `cos(π/(2p))` between `cos ϑ₊` and `cos ϑ₋` for rational `ϑ₋ ≤ π/(2p) ≤ ϑ₊` (Mathlib's 20-digit bounds of `π`). -/
theorem cos_theta_encl {p θlo θhi clo chi : ℝ} (hp : 0 < p) (hθlo0 : 0 ≤ θlo)
    (hθlo : θlo * (2 * p) ≤ 314159265358979323846 / 100000000000000000000)
    (hθhi : 314159265358979323847 / 100000000000000000000 ≤ θhi * (2 * p)) (hθhi3 : θhi ≤ 3)
    (hclo : clo ≤ cos θhi) (hchi : cos θlo ≤ chi) :
    clo ≤ cos (π / (2 * p)) ∧ cos (π / (2 * p)) ≤ chi := by
  have h1 : (314159265358979323846 / 100000000000000000000 : ℝ) < π := by
    have := pi_gt_d20; norm_num at this ⊢; linarith
  have h2 : π < (314159265358979323847 / 100000000000000000000 : ℝ) := by
    have := pi_lt_d20; norm_num at this ⊢; linarith
  have h3 := pi_gt_three
  have hp2 : 0 < 2 * p := by positivity
  have hl : θlo ≤ π / (2 * p) := by rw [le_div_iff₀ hp2]; linarith
  have hh : π / (2 * p) ≤ θhi := by rw [div_le_iff₀ hp2]; linarith
  have h0 : 0 ≤ π / (2 * p) := div_nonneg pi_pos.le hp2.le
  exact ⟨hclo.trans (cos_le_cos_of_nonneg_of_le_pi h0 (by linarith) hh),
    (cos_le_cos_of_nonneg_of_le_pi hθlo0 (by linarith) hl).trans hchi⟩

theorem exp_half_sq (x : ℝ) : exp (x / 2) ^ 2 = exp x := by rw [sq, ← exp_add, add_halves]

/-- Upper bound of `cosh x` from bounds of `exp(x/2)`. -/
theorem cosh_upper {x lo hi C : ℝ} (h : lo ≤ exp (x / 2) ∧ exp (x / 2) ≤ hi) (hlo : 0 < lo)
    (hC : (hi ^ 2 + (lo ^ 2)⁻¹) / 2 ≤ C) : cosh x ≤ C := by
  have h1 : exp x ≤ hi ^ 2 := by rw [← exp_half_sq]; exact pow_le_pow_left₀ (exp_pos _).le h.2 2
  have h2 : lo ^ 2 ≤ exp x := by rw [← exp_half_sq]; exact pow_le_pow_left₀ hlo.le h.1 2
  have h3 : (exp x)⁻¹ ≤ (lo ^ 2)⁻¹ := inv_anti₀ (by positivity) h2
  rw [cosh_eq, exp_neg]; linarith

/-- Lower bound of `cosh x` from bounds of `exp(x/2)`. -/
theorem cosh_lower {x lo hi C : ℝ} (h : lo ≤ exp (x / 2) ∧ exp (x / 2) ≤ hi) (hlo : 0 < lo)
    (hC : C ≤ (lo ^ 2 + (hi ^ 2)⁻¹) / 2) : C ≤ cosh x := by
  have h1 : exp x ≤ hi ^ 2 := by rw [← exp_half_sq]; exact pow_le_pow_left₀ (exp_pos _).le h.2 2
  have h2 : lo ^ 2 ≤ exp x := by rw [← exp_half_sq]; exact pow_le_pow_left₀ hlo.le h.1 2
  have h3 : (hi ^ 2)⁻¹ ≤ (exp x)⁻¹ := inv_anti₀ (exp_pos x) h1
  rw [cosh_eq, exp_neg]; linarith

/-- Upper bound of `cos t` from `cos t = 2cos²(t/2) - 1`. -/
theorem cos_upper_half {t hi H : ℝ} (h0 : 0 ≤ cos (t / 2)) (hc : cos (t / 2) ≤ hi) (hH : 2 * hi ^ 2 - 1 ≤ H) :
    cos t ≤ H := by
  have e : cos t = 2 * cos (t / 2) ^ 2 - 1 := by rw [← cos_two_mul]; congr 1; ring
  have := pow_le_pow_left₀ h0 hc 2
  linarith

/-- The reduction: `Γ(y,t) < e(t)` from rational bounds of `cos ϑ`, `cosh y + cos t`, `cosh(sy/2)`, `cos(pt/2)`, with
`p/2 = m/n` and `a/b ≤ p/s` (`Γ`'s second term only needs a LOWER bound, and `x ↦ c^x` increases for `c ≥ 1`). -/
theorem gam_lt_ee_of_bounds {p s y t clo chi Ahi Yhi F1 Xlo F2 slo Elo : ℝ} {m n a b : ℕ}
    (hp1 : 1 < p) (hn : n ≠ 0) (hb : b ≠ 0) (hpmn : p / 2 = (m : ℝ) / n) (hab : (a : ℝ) / b ≤ p / s)
    (hclo : 0 < clo) (hc : clo ≤ cos (π / (2 * p)) ∧ cos (π / (2 * p)) ≤ chi)
    (hA : cosh y + cos t ≤ Ahi) (hY : Ahi / (2 * clo ^ 2) ≤ Yhi) (hF1 : 0 ≤ F1) (hF1' : Yhi ^ m ≤ F1 ^ n)
    (hXlo : 1 ≤ Xlo) (hX : Xlo ≤ cosh (s * y / 2)) (hF2 : 0 ≤ F2) (hF2' : F2 ^ b ≤ Xlo ^ a)
    (hslo : 0 ≤ slo) (hs2 : slo ^ 2 ≤ 1 - chi ^ 2) (hElo : 0 ≤ Elo) (hE : Elo ≤ cos (p / 2 * t))
    (hfin : F1 - F2 < slo / chi * Elo) : Gam p s y t < ee p t := by
  have hp0 : 0 < p := by linarith
  have hθ0 : 0 < π / (2 * p) := by positivity
  have hθπ : π / (2 * p) < π := by
    rw [div_lt_iff₀ (by positivity)]; nlinarith [pi_pos]
  have hc0 : 0 < cos (π / (2 * p)) := hclo.trans_le hc.1
  have hchi : 0 < chi := hc0.trans_le hc.2
  have hAnn : 0 ≤ cosh y + cos t := by linarith [one_le_cosh y, neg_one_le_cos t]
  have hYnn : 0 ≤ Ahi / (2 * clo ^ 2) := div_nonneg (hAnn.trans hA) (by positivity)
  -- the first term of `Γ`
  have hden : 1 + cos (2 * (π / (2 * p))) = 2 * cos (π / (2 * p)) ^ 2 := by rw [cos_two_mul]; ring
  have hcc : 2 * clo ^ 2 ≤ 2 * cos (π / (2 * p)) ^ 2 :=
    mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hclo.le hc.1 2) (by norm_num)
  have hle : (cosh y + cos t) / (2 * cos (π / (2 * p)) ^ 2) ≤ Ahi / (2 * clo ^ 2) :=
    div_le_div₀ (hAnn.trans hA) hA (mul_pos two_pos (pow_pos hclo 2)) hcc
  have hT1 : (cosh y + cos t) ^ (p / 2) / (1 + cos (2 * (π / (2 * p)))) ^ (p / 2) ≤ F1 := by
    rw [hden, ← div_rpow hAnn (by positivity), hpmn]
    calc ((cosh y + cos t) / (2 * cos (π / (2 * p)) ^ 2)) ^ ((m : ℝ) / n)
        ≤ Yhi ^ ((m : ℝ) / n) := rpow_le_rpow (div_nonneg hAnn (by positivity)) (hle.trans hY) (by positivity)
      _ ≤ F1 := rpow_le_of_pow_le (hYnn.trans hY) hF1 hn hF1'
  -- the second term of `Γ`
  have hX1 : 1 ≤ cosh (s * y / 2) := hXlo.trans hX
  have hT2 : F2 ≤ cosh (s * y / 2) ^ (p / s) :=
    calc F2 ≤ Xlo ^ ((a : ℝ) / b) := le_rpow_of_pow_le (by linarith) hF2 hb hF2'
      _ ≤ cosh (s * y / 2) ^ ((a : ℝ) / b) := rpow_le_rpow (by linarith) hX (by positivity)
      _ ≤ cosh (s * y / 2) ^ (p / s) := rpow_le_rpow_of_exponent_le hX1 hab
  -- `e(t) = tan ϑ cos(pt/2)`, with `sin ϑ ≥ √(1 - chi²)`
  have hsin0 : 0 ≤ sin (π / (2 * p)) := sin_nonneg_of_nonneg_of_le_pi hθ0.le hθπ.le
  have hcos2 : cos (π / (2 * p)) ^ 2 ≤ chi ^ 2 := pow_le_pow_left₀ hc0.le hc.2 2
  have hsin2 : slo ^ 2 ≤ sin (π / (2 * p)) ^ 2 := by nlinarith [sin_sq_add_cos_sq (π / (2 * p))]
  have hsin : slo ≤ sin (π / (2 * p)) := by nlinarith
  have htan : slo / chi ≤ tan (π / (2 * p)) := by
    rw [tan_eq_sin_div_cos]; exact div_le_div₀ hsin0 hsin hc0 hc.2
  have hee : slo / chi * Elo ≤ ee p t := by
    unfold ee; exact mul_le_mul htan hE hElo ((div_nonneg hslo hchi.le).trans htan)
  unfold Gam
  linarith

/-- One point with `Γ < e` at `s₊` gives the failure of (HV) on all of `[s₊, sec²ϑ]` (as `C18_upper_by_point`). -/
theorem fails_of_point {p sp y t : ℝ} (hp1 : 1 < p) (hp2 : p < 2) (hsp : 0 < sp) (hpt : Gam p sp y t < ee p t)
    (ht : t ∈ Icc (-π) π) : ∀ s ∈ Icc sp (Ssec p), ¬ HVIneq p s (hvConst p s) := by
  intro s hs
  exact prop_fail hp1 hp2 (by linarith [hs.1]) hs.2
    ⟨y, t, ht, lt_of_le_of_lt (gam_antitone_s p sp s y t (by linarith) hsp hs.1) hpt⟩

